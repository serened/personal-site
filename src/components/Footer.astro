---
import siteConfig from '../data/site-config';
import Guardian from './marks/Guardian.astro';

// "elsewhere" links: the two sibling projects (placeholder hrefs for Serene to
// fill) followed by any configured social links.
const elsewhere = [
    { text: 'Bookplate', href: '#' },
    { text: 'OrganizedSpine', href: '#' },
    ...(siteConfig.socialLinks ?? [])
];
---

<footer class="border-paper-edge mx-auto mt-16 flex w-full max-w-3xl items-end justify-between gap-6 border-t pt-6 pb-10 sm:mt-24 sm:pb-14">
    <div class="flex flex-col gap-2">
        <p class="text-ink-faint text-sm">
            <span class="small-caps">elsewhere:</span>{' '}
            {
                elsewhere.map((link, i) => (
                    <>
                        {i > 0 && <span aria-hidden="true"> · </span>}
                        <a
                            class="hover:text-ink"
                            href={link.href}
                            {...(link.href.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                        >
                            {link.text}
                        </a>
                    </>
                ))
            }
        </p>
        <p class="text-ink-faint font-serif text-sm">grew up in New Mexico · lives in Philadelphia</p>
    </div>
    <span class="text-ink-stone block w-10 shrink-0">
        <Guardian class="w-full" />
    </span>
</footer>
