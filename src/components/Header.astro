---
import siteConfig from '../data/site-config';
import Moth from './marks/Moth.astro';
---

<header class="mx-auto mb-8 flex w-full max-w-3xl items-center justify-between gap-4 pt-2 sm:mb-10">
    <a class="flex items-center gap-3" href="/" aria-label={`${siteConfig.title}, home`}>
        <span class="text-ink block w-11 shrink-0">
            <Moth class="w-full" />
        </span>
        <span class="text-clay font-serif text-[17px] font-medium lowercase italic">{siteConfig.title}</span>
    </a>
    {siteConfig.subtitle && <p class="text-ink-faint hidden text-[15px] italic sm:block">{siteConfig.subtitle}</p>}
</header>
