---
import siteConfig from '../data/site-config';
import Moth from './marks/Moth.astro';
---

<header class="mx-auto mb-12 flex w-full max-w-3xl items-center justify-between gap-4 sm:mb-16">
    <a class="flex items-center gap-3" href="/" aria-label={`${siteConfig.title} — home`}>
        <span class="text-ink block w-11 shrink-0 sm:w-12">
            <Moth class="w-full" />
        </span>
        <span class="text-clay font-serif text-2xl leading-tight font-medium lowercase italic sm:text-3xl">
            {siteConfig.title}
        </span>
    </a>
    {siteConfig.subtitle && <p class="text-ink-faint hidden font-serif text-sm italic sm:block">{siteConfig.subtitle}</p>}
</header>
